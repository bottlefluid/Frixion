rules_version = '2';
// Frixion's Firestore rules, phase 2 (v4.51, tightened in v4.52). To use them: Firebase console > Firestore Database > Rules, paste all of
// this in, then Publish. database.rules.json goes in Realtime Database > Rules the same way.
//
// Who is asking comes from the sign-in (Firebase Authentication) and accounts/{its uid}, which says which Frixion
// account it is. That entry is made once, for a profile that names the same sign-in back, and nothing can change it
// afterwards. Everything below checks the person asking against it, so a copy of Frixion on another address, or a
// script, can only do what that person could do in Frixion anyway.
//
// Since v4.52 server and channel permissions are checked too: who can see and post in each channel (its overrides),
// deleting or pinning other people's messages, kicks, bans, timeouts, nicknames, the audit log, and managing channels,
// roles and the server itself. Only a server's first 8 roles, and a member's first 4, count here (the 1000-step limit).
// Since v4.54 also slowmode (slowOk()) and role order (roleEditOk(): Manage Roles only gives roles below your own).
// What these rules can't check (the app checks them, so only a script gets round them):
// - Orbs, Premium and the Shop. Games run in the browser, so a player can still give themselves Orbs or Premium days.
// - Slowmode in threads, and the smaller channel permissions (files, embeds, polls, @everyone).
// The Discord bridge, push notifications and owner tools (functions/api) use a service account, which these rules don't
// limit. The games' shared lobby is in the Realtime Database: database.rules.json.
//
// For whoever edits this: rules may only evaluate 1000 steps per request, and a function runs again every time it's
// called, but a value passed to a function is worked out once. So each rule works out who is asking once, with who(),
// and passes it on as `m`; and a server, DM or group is fetched once and passed on as `s` or `c`.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is asking ----------
    function signedIn() { return request.auth != null; }
    function acctPath() { return /databases/$(database)/documents/accounts/$(request.auth.uid); }
    function profilePath(name) { return /databases/$(database)/documents/users/$(name); }
    // Owner 3 > Co-Owner 2 > Admin 1 > everyone 0, the same order as platformRank() in script.js.
    function rankOf(u) {
      return u.get('owner', false) == true ? 3 : (u.get('coowner', false) == true ? 2 : (u.get('op', false) == true ? 1 : 0));
    }
    // The person asking: name (their username), ok (the sign-in really is that account: its accounts/ entry names the
    // profile, and the profile names the sign-in back), rank and u (their profile). A sign-in with no Frixion account
    // makes this an error, which refuses the request.
    function who() {
      let name = get(acctPath()).data.username;
      let u = get(profilePath(name)).data;
      return { 'name': name, 'ok': signedIn() && u.get('authUid', '') == request.auth.uid, 'rank': rankOf(u), 'u': u };
    }
    function isWho(m, name) { return m.ok && m.name == name; }
    function isStaff(m) { return m.ok && m.rank >= 1; }
    function isOwnerLevel(m) { return m.ok && m.rank >= 2; }
    // Banned and muted accounts can still read, but can't post.
    function canPost(m) {
      let now = request.time.toMillis();
      let bannedUntil = m.u.get('bannedUntil', null);
      let mutedUntil = m.u.get('mutedUntil', null);
      return !(m.u.get('banned', false) == true && (bannedUntil == null || bannedUntil > now))
        && (mutedUntil == null || mutedUntil <= now);
    }
    // Not banned from Frixion right now: a banned account sees nothing but its own profile (the ban screen).
    function active(m) {
      let until = m.u.get('bannedUntil', null);
      return m.ok && !(m.u.get('banned', false) == true && (until == null || until > request.time.toMillis()));
    }

    // ---------- what is changing ----------
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function same(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }
    function listAfter(f) { return request.resource.data.get(f, []); }
    function listBefore(f) { return resource.data.get(f, []); }
    // The list `f` gained (or lost) `name`, and nothing else changed in it.
    function onlyAdded(f, name) { return listAfter(f).toSet() == listBefore(f).toSet().union([name].toSet()); }
    function onlyTakenOut(f, name) { return listAfter(f).toSet() == listBefore(f).toSet().difference([name].toSet()); }
    // The list `f` only lost names.
    function onlyRemoved(f) { return listAfter(f).toSet().difference(listBefore(f).toSet()).size() == 0; }

    // ---------- accounts ----------
    // Which Frixion account a sign-in is: made once, by that sign-in, for the profile it just made (or moved over).
    match /accounts/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff(who()));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'at'])
        && request.resource.data.username is string
        && exists(profilePath(request.resource.data.username))
        && get(profilePath(request.resource.data.username)).data.get('authUid', '') == uid;
      allow list, update, delete: if false;
    }

    // ---------- profiles ----------
    match /users/{username} {
      allow get: if signedIn();                                     // (signing up checks names after making the sign-in)
      allow list: if signedIn();
      // A new profile belongs to the sign-in making it (one per sign-in), with no staff powers, bans or extra Orbs.
      allow create: if signedIn() && !exists(acctPath())
        && request.resource.data.get('username', '') == username
        && request.resource.data.get('authUid', '') == request.auth.uid
        && !request.resource.data.keys().hasAny(['password', 'owner', 'coowner', 'terminated', 'redirectUrl', 'redirectNonce', 'mutedUntil', 'muteReason'])
        && request.resource.data.get('op', false) == false
        && request.resource.data.get('banned', false) == false
        && request.resource.data.get('premiumUntil', null) == null
        && request.resource.data.get('orbs', 0) <= 50;
      allow update: if profileUpdate(who(), username);
      allow delete: if profileDelete(who(), username);

      // Notes for the person they mention (from a server both are in). Only that person reads them.
      match /mentions/{id} {
        allow read, delete: if isWho(who(), username);
        allow create: if mentionCreate(who(), username);
      }
      // What you have read (unread dots), synced between your devices.
      match /meta/{docId} {
        allow read, write: if isWho(who(), username);
      }
      // Notes about this person that only their author can see.
      match /privateNotes/{author} {
        allow read, write: if isWho(who(), author);
      }
    }
    function profileUpdate(m, username) {
      let k = changed();
      return m.ok && (selfEdit(m, k, username) || staffEdit(m, k, username) || friendEdit(m, k));
    }
    // Delete Account: the owner flags the account and its own app removes it at the end of the sequence.
    function profileDelete(m, username) {
      return m.ok && ((m.name == username && resource.data.get('terminated', {}).get('mode', '') == 'real') || m.rank >= 2);
    }
    // Your own profile: anything except your rank, sign-in, bans and mutes. A few staff-set fields may only be cleared.
    function selfEdit(m, k, username) {
      return m.name == username
        && !k.hasAny(['authUid', 'owner', 'coowner', 'op', 'username', 'createdAt', 'mutedUntil', 'muteReason'])
        && (!k.hasAny(['banned', 'banReason', 'bannedUntil']) || clearingExpiredBan())
        && (!k.hasAny(['redirectUrl', 'redirectNonce']) || !request.resource.data.keys().hasAny(['redirectUrl', 'redirectNonce']))
        && (!k.hasAny(['terminated']) || !('terminated' in request.resource.data))
        && !('password' in request.resource.data);
    }
    function clearingExpiredBan() {
      return resource.data.get('banned', false) == true
        && resource.data.get('bannedUntil', null) is number
        && resource.data.bannedUntil <= request.time.toMillis()
        && request.resource.data.get('banned', true) == false;
    }
    // Staff on someone else: Admins can change Orbs, Premium, bans and mutes; Co-Owners and the Owner anything except
    // ownership and sign-ins, and only the Owner makes Co-Owners. Nobody touches an equal or higher Co-Owner/Owner
    // (canManagePlatformUser() in script.js).
    function staffEdit(m, k, username) {
      let theirs = rankOf(resource.data);
      return m.rank >= 1
        && (m.name == username || (theirs >= 2 ? m.rank > theirs : true))
        && !k.hasAny(['owner', 'username', 'createdAt', 'authUid'])
        && (!k.hasAny(['coowner']) || m.rank == 3)
        && !('password' in request.resource.data)
        && (m.rank >= 2 || k.hasOnly(['premiumUntil', 'orbs', 'banned', 'banReason', 'bannedUntil', 'mutedUntil', 'muteReason']));
    }
    // Friend requests change both accounts. On the other person's account you may only add or remove yourself, and you
    // may only add yourself to their friends while their request to you is still there (script.js sends these together).
    function friendEdit(m, k) {
      return k.hasOnly(['incomingRequests', 'outgoingRequests', 'friends'])
        && (!k.hasAny(['incomingRequests']) || onlyAdded('incomingRequests', m.name) || onlyTakenOut('incomingRequests', m.name))
        && (!k.hasAny(['outgoingRequests']) || onlyTakenOut('outgoingRequests', m.name))
        && (!k.hasAny(['friends']) || onlyTakenOut('friends', m.name)
            || (onlyAdded('friends', m.name) && m.name in resource.data.get('outgoingRequests', [])));
    }
    // ... and only about your own real message there (noteChannelMessage()), with the real server, channel and thread
    // names on it (v4.54: so nobody can make a note look like it came from somewhere else).
    function mentionCreate(m, username) {
      let d = request.resource.data;
      let s = get(/databases/$(database)/documents/servers/$(d.sid)).data;
      let threaded = d.get('tid', null) != null;
      let msg = !threaded
        ? get(/databases/$(database)/documents/servers/$(d.sid)/channels/$(d.cid)/messages/$(d.mid)).data
        : get(/databases/$(database)/documents/servers/$(d.sid)/threads/$(d.tid)/messages/$(d.mid)).data;
      return active(m) && username != m.name && d.get('from', '') == m.name
        && m.name in s.get('members', []) && username in s.get('members', []) && msg.get('uid', '') == m.name
        && d.keys().hasOnly(['sid', 'cid', 'tid', 'mid', 'from', 'text', 'at', 'server', 'channel', 'thread'])
        && d.get('text', '') is string && d.get('text', '').size() <= 200 && d.get('at', null) == request.time
        && d.get('server', '') == s.get('name', '')
        && d.get('channel', '') == get(/databases/$(database)/documents/servers/$(d.sid)/channels/$(d.cid)).data.get('name', '')
        && d.get('thread', '') == (threaded ? get(/databases/$(database)/documents/servers/$(d.sid)/threads/$(d.tid)).data.get('name', '') : '');
    }

    // ---------- things staff publish (the Shop, emoji, stickers, the word filter): for anyone signed in ----------
    match /config/{docId}            { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /customEmojis/{id}         { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /stickers/{id}             { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /shopDecorations/{id}      { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /shopThemes/{id}           { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /shopNameplates/{id}       { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /shopBanners/{id}          { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /shopProfileEffects/{id}   { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /shopProfileFrames/{id}    { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /gardenSeeds/{id}          { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /gardenSprinklers/{id}     { allow read: if signedIn(); allow write: if isStaff(who()); }
    match /gardenPets/{id}           { allow read: if signedIn(); allow write: if isStaff(who()); }

    // ---------- codes ----------
    match /redeemCodes/{code} {
      allow get: if signedIn();                                     // redeeming: you have to know the code
      allow list, delete: if isStaff(who());
      allow create: if codeCreate(who());
      allow update: if codeUpdate(who());
    }
    function codeCreate(m) { return m.ok && (m.rank >= 1 || buyingPremiumCode(m)); }
    function codeUpdate(m) { return m.ok && (m.rank >= 1 || redeeming(m)); }
    // A Premium code someone buys, in the same transaction that takes 1400 of their Orbs (buyPremiumCode()).
    function buyingPremiumCode(m) {
      let d = request.resource.data;
      return d.get('type', '') == 'premium' && d.get('value', 0) is int && d.value > 0 && d.value <= 31
        && d.get('createdBy', '') == m.name
        && d.get('redeemedBy', null) == null && d.get('uses', 0) == 0 && d.get('usedBy', []).size() == 0
        && d.get('maxUses', 1) == 1
        && getAfter(profilePath(m.name)).data.get('orbs', 0) <= m.u.get('orbs', 0) - 1400;
    }
    // Using a code once: you join its usedBy and its use count goes up by one, while it has uses left (codeUsage()).
    function redeeming(m) {
      let before = resource.data;
      let used = before.keys().hasAny(['usedBy']) ? before.usedBy : (before.get('redeemedBy', null) != null ? [before.redeemedBy] : []);
      let n = before.get('uses', 0) > used.size() ? before.get('uses', 0) : used.size();
      let most = before.get('maxUses', 1);
      let after = request.resource.data;
      return changed().hasOnly(['uses', 'usedBy', 'redeemedBy', 'redeemedAt'])
        && !(m.name in used)
        && (most == 0 || n < most)
        && after.get('uses', -1) == n + 1
        && after.get('usedBy', []) == used.concat([m.name])
        && after.get('redeemedBy', null) == m.name;
    }

    // ---------- whole-computer bans ----------
    // A banned computer's hardware fingerprint (adminBanDevice()). Every browser and app on that computer checks it before
    // anyone signs in, so it can be read by its exact id (a hash, which nobody can list); only the Owner and Co-Owners set it.
    match /bannedHw/{hw} {
      allow get: if true;
      allow list, write: if isOwnerLevel(who());
    }

    // ---------- device bans ----------
    match /devices/{id} {
      allow get: if true;                                           // the ban check runs before anyone signs in
      allow list: if deviceList(who());
      allow create: if deviceCreate(who(), id);
      allow update: if deviceUpdate(who());
      allow delete: if isOwnerLevel(who());
    }
    function deviceList(m) { return m.ok && (m.rank >= 2 || m.name in resource.data.get('accounts', [])); }
    function deviceCreate(m, id) {
      return m.ok && request.resource.data.get('id', '') == id
        && request.resource.data.get('banned', false) == false
        && !('vmAllowed' in request.resource.data)
        && request.resource.data.get('accounts', []) == [m.name];
    }
    // Anyone may record their own visit or ban their own device (the ban-evasion and virtual machine checks ban
    // themselves). The Owner and Co-Owners only ban, unban and let a virtual machine in (vmAllowed) on others' devices
    // (v4.55): they can't add anyone to a device or rewrite what it says about itself.
    function deviceUpdate(m) {
      let k = changed();
      return m.ok
        && ((same('id')
          && m.name in request.resource.data.get('accounts', [])
          && (same('accounts') || onlyAdded('accounts', m.name))
          && !k.hasAny(['vmAllowed'])
          && (!k.hasAny(['banned', 'banReason', 'bannedBy', 'bannedAt', 'autoBanned', 'unbannedBy', 'unbannedAt'])
              || (resource.data.get('banned', false) == false && request.resource.data.get('banned', false) == true
                  && k.hasOnly(['banned', 'banReason', 'bannedBy', 'bannedAt', 'autoBanned']))))
          || (m.rank >= 2 && k.hasOnly(['banned', 'banReason', 'bannedBy', 'bannedAt', 'autoBanned', 'unbannedBy', 'unbannedAt', 'vmAllowed'])));
    }

    // ---------- network addresses (v4.55) ----------
    // Which accounts and devices used each address (ips/<id>, written by functions/api/admin/seen), and banned ones
    // (bannedIps/<id>, which functions/api/admin/ip checks before anyone signs in). Ids, never the addresses.
    match /ips/{id} {
      allow read: if isOwnerLevel(who());
    }
    match /bannedIps/{id} {
      allow read, delete: if isOwnerLevel(who());
      allow create, update: if isOwnerLevel(who()) && request.resource.data.keys().hasOnly(['reason', 'by', 'at', 'label'])
        && request.resource.data.get('reason', '') is string && request.resource.data.get('reason', '').size() <= 200;
    }

    // ---------- messages (servers, threads, DMs and group DMs) ----------
    function newAuthorIsMe(m) { return request.resource.data.get('uid', '') == m.name && freshAndSmall(request.resource.data, m); }
    // A new message is stamped with the real time (the app always uses the server's clock), give or take a few minutes,
    // so nobody posts something dated in the past or stuck at the bottom in the future; and its text isn't huge.
    function freshAndSmall(d, m) {
      return d.get('createdAt', null) is timestamp && d.createdAt > request.time - duration.value(5, 'm') && d.createdAt < request.time + duration.value(1, 'm')
        && (!('text' in d) || textFits(d.text, m));
    }
    // Message text within the app's limits (myMessageLimit() in script.js): the Owner's go up to 900,000 characters
    // (MESSAGE_SIZE_CAP), everyone else's to 10,000 (the app itself stops them at 1,000, or 5,000 for co-owners).
    function textFits(t, m) { return t is string && t.size() <= (m.ok && m.rank >= 3 ? 900000 : 10000); }
    // Sapphire posts purge results (only for someone who can purge there: canPurge) and Wordle posts game cards, both as
    // themselves (postBotMessage()), and nothing else.
    function newBotMessage(m, canPurge) {
      let d = request.resource.data;
      return freshAndSmall(d, m) && (d.get('uid', '') == 'bot-sapphire' && canPurge && d.keys().hasOnly(['uid', 'username', 'createdAt', 'purgeResult', 'replyTo']))
        || (d.get('uid', '') == 'bot-wordle' && d.keys().hasOnly(['uid', 'username', 'createdAt', 'wordle', 'replyTo'])
            && d.get('wordle', {}).get('startedBy', '') == m.name && freshAndSmall(d, m));
    }
    function isMine(m) { return resource.data.get('uid', '') == m.name; }
    // Your own message: anything but who sent it, and (like on anyone's message) only your own reaction.
    function ownEdit(m, k) {
      return isMine(m) && !k.hasAny(['uid', 'createdAt']) && (!k.hasAny(['reactions', 'lastReaction']) || myReactionOnly(m))
        && (!k.hasAny(['text']) || textFits(request.resource.data.text, m));
    }
    // A reaction: only the one lastReaction names (toggleReaction() sends it), and only your own name added or taken off.
    function myReactionOnly(m) {
      let lr = request.resource.data.get('lastReaction', {});
      let e = lr.get('e', '');
      let before = resource.data.get('reactions', {});
      let after = request.resource.data.get('reactions', {});
      return lr.get('by', '') == m.name && e is string && e != ''
        && after.diff(before).affectedKeys().hasOnly([e])
        && (after.get(e, []).toSet() == before.get(e, []).toSet().union([m.name].toSet())
            || after.get(e, []).toSet() == before.get(e, []).toSet().difference([m.name].toSet()));
    }
    function pollVoteOnly(m) {
      let before = resource.data.get('poll', {});
      let after = request.resource.data.get('poll', {});
      return after.diff(before).affectedKeys().hasOnly(['votes'])
        && after.get('votes', {}).diff(before.get('votes', {})).affectedKeys().hasOnly([m.name]);
    }
    function wordleOnlyMine(m) {
      let before = resource.data.get('wordle', {});
      let after = request.resource.data.get('wordle', {});
      return after.diff(before).affectedKeys().hasOnly(['plays'])
        && after.get('plays', {}).diff(before.get('plays', {})).affectedKeys().hasOnly([m.name]);
    }
    // Moderation on someone else's message only takes things away: its text (when a file stays) or a file.
    function clearingOnly(k) {
      return (!k.hasAny(['text']) || request.resource.data.get('text', '') == '')
        && (!k.hasAny(['edited']) || request.resource.data.get('edited', false) == false)
        && (!k.hasAny(['attachments']) || request.resource.data.get('attachments', []).size()
              < resource.data.get('attachments', []).size() + ('attachment' in resource.data ? 1 : 0))
        && (!k.hasAny(['attachment']) || !('attachment' in request.resource.data));
    }
    // Someone else's message in a DM or group: react, vote, play its Wordle.
    function dmOthersEdit(m, k) {
      return k.hasOnly(['reactions', 'lastReaction', 'poll', 'wordle'])
        && (!k.hasAny(['reactions', 'lastReaction']) || myReactionOnly(m))
        && (!k.hasAny(['poll']) || pollVoteOnly(m))
        && (!k.hasAny(['wordle']) || wordleOnlyMine(m));
    }
    // ... and in a server: also start a thread on it, and with the permission (p, from permsIn()) pin it or clear it.
    function serverOthersEdit(m, k, p) {
      return k.hasOnly(['reactions', 'lastReaction', 'poll', 'wordle', 'thread', 'pinned', 'text', 'edited', 'attachments', 'attachment'])
        && (!k.hasAny(['reactions', 'lastReaction']) || myReactionOnly(m))
        && (!k.hasAny(['poll']) || pollVoteOnly(m))
        && (!k.hasAny(['wordle']) || wordleOnlyMine(m))
        && (!k.hasAny(['text', 'edited', 'attachments', 'attachment']) || (clearingOnly(k) && hasOne(p, ['manageMessages'])))
        && (!k.hasAny(['pinned']) || hasOne(p, ['pinMessages', 'manageMessages']));
    }
    // Auto-delete: whoever opens a conversation sweeps its messages older than 7 days (sweepOldMessages()).
    function isOld() { return resource.data.get('createdAt', null) is timestamp && resource.data.createdAt < request.time - duration.value(7, 'd'); }

    // ---------- servers ----------
    function srv(sid) { return get(/databases/$(database)/documents/servers/$(sid)).data; }
    function chan(sid, cid) { return get(/databases/$(database)/documents/servers/$(sid)/channels/$(cid)).data; }
    function threadOf(sid, tid) { return get(/databases/$(database)/documents/servers/$(sid)/threads/$(tid)).data; }
    function isMember(m, s) { return m.name in s.get('members', []); }
    // In the server (or Frixion staff), and not banned from Frixion.
    function inServer(m, s) { return active(m) && (isMember(m, s) || m.rank >= 1); }
    function notTimedOut(m, s) { return s.get('timeouts', {}).get(m.name, 0) <= request.time.toMillis(); }
    // Server permissions, as hasServerPerm() in script.js: the server's owner and Frixion staff have them all; everyone
    // else has what @everyone and their roles give them, and Administrator gives everything. An @everyone role saved
    // before roles had their own permission list also gets Discord's defaults (everyoneRole()). Rules can't loop, so the
    // roles are gone through one by one, and only a server's first 8 count.
    function everyoneDefaults() {
      return ['viewChannels', 'createExpressions', 'createInvite', 'changeNickname', 'sendMessages', 'sendMessagesInThreads',
        'createPublicThreads', 'createPrivateThreads', 'embedLinks', 'attachFiles', 'addReactions', 'useExternalEmoji',
        'useExternalStickers', 'readMessageHistory', 'sendTTS', 'sendVoiceMessages', 'createPolls', 'connect', 'speak',
        'video', 'useSoundboard', 'useExternalSounds', 'useVAD', 'useApplicationCommands', 'useActivities',
        'useExternalApps', 'requestToSpeak', 'createEvents'];
    }
    function rp(r, mine) { return r.get('id', '') == 'everyone' || r.get('id', '') in mine ? r.get('permissions', []) : []; }
    function rolePermsOf(m, s) {
      let roles = s.get('roles', []);
      let n = roles.size();
      let mine = s.get('memberRoles', {}).get(m.name, []);
      let p = (n > 0 ? rp(roles[0], mine) : []).concat(n > 1 ? rp(roles[1], mine) : []).concat(n > 2 ? rp(roles[2], mine) : [])
        .concat(n > 3 ? rp(roles[3], mine) : []).concat(n > 4 ? rp(roles[4], mine) : []).concat(n > 5 ? rp(roles[5], mine) : [])
        .concat(n > 6 ? rp(roles[6], mine) : []).concat(n > 7 ? rp(roles[7], mine) : []);
      return n > 0 && roles[0].get('id', '') == 'everyone' && roles[0].get('permsV2', false) == true ? p : p.concat(everyoneDefaults());
    }
    function isServerBoss(m, s) { return s.get('ownerId', '') == m.name || m.rank >= 1; }
    // Everything m may do in server s, as a list: just Administrator (everything) for its owner and Frixion staff.
    function permsIn(m, s) { return isServerBoss(m, s) ? ['administrator'] : rolePermsOf(m, s); }
    function hasAll(p, needed) { return p.hasAny(['administrator']) || p.hasAll(needed); }
    function hasOne(p, perms) { return p.hasAny(perms.concat(['administrator'])); }
    function canManageChannels(m, s) { return m.ok && hasOne(permsIn(m, s), ['manageChannels']); }
    // Channel permissions, as channelPermissionsFor() in script.js: the server's (p), then the @everyone override, then
    // all of the member's role overrides together (denies, then allows; their first 4 roles), and nothing at all without
    // View Channels. The older visibleToRoles ("only these roles can see it") counts too. Administrator sees everything.
    function roleOw(ow, mine, kind) {
      return (mine.size() > 0 ? ow.get(mine[0], {}).get(kind, []) : []).concat(mine.size() > 1 ? ow.get(mine[1], {}).get(kind, []) : [])
        .concat(mine.size() > 2 ? ow.get(mine[2], {}).get(kind, []) : []).concat(mine.size() > 3 ? ow.get(mine[3], {}).get(kind, []) : []);
    }
    function chanPerms(m, s, ch, p) {
      let ow = ch.get('overwrites', {});
      let ev = ow.get('everyone', {});
      let mine = s.get('memberRoles', {}).get(m.name, []);
      let after = p.toSet().difference(ev.get('deny', []).toSet()).union(ev.get('allow', []).toSet())
        .difference(roleOw(ow, mine, 'deny').toSet()).union(roleOw(ow, mine, 'allow').toSet());
      let legacy = ch.get('visibleToRoles', []);
      return after.hasAny(['viewChannels']) && (legacy.size() == 0 || legacy.hasAny(mine)) ? after : [].toSet();
    }
    function canInChannel(m, s, ch, p, need) { return p.hasAny(['administrator']) || chanPerms(m, s, ch, p).hasAll(need); }
    function seesChannel(m, s, ch) { return inServer(m, s) && canInChannel(m, s, ch, permsIn(m, s), ['viewChannels']); }

    // A new server is its maker's, with only them in it. createdAt is the real time, so the oldest server with an invite
    // code keeps it (findServerByInvite()).
    function serverCreate(m) {
      return m.ok
        && request.resource.data.get('ownerId', '') == m.name
        && request.resource.data.get('members', []) == [m.name]
        && request.resource.data.get('bannedUsers', []).size() == 0
        && request.resource.data.get('memberRoles', {}).size() == 0
        && request.resource.data.get('createdAt', null) == request.time;
    }
    // Nobody can take a server over or change its invite code. Anyone can join (unless banned), leave, vanish or set their
    // own nickname; everything else needs the matching permission.
    function serverUpdate(m, s) {
      let k = changed();
      return m.ok && same('ownerId') && same('inviteCode') && same('createdAt')
        && (joining(m, k, s) || leaving(m, k) || vanishing(m, k, s) || ownNickname(m, k, s) || managing(m, k, s));
    }
    function joining(m, k, s) { return active(m) && k.hasOnly(['members']) && onlyAdded('members', m.name) && !(m.name in s.get('bannedUsers', [])); }
    function leaving(m, k) {
      return k.hasOnly(['members', 'vanished']) && onlyTakenOut('members', m.name) && (!k.hasAny(['vanished']) || onlyTakenOut('vanished', m.name));
    }
    function vanishing(m, k, s) {
      return k.hasOnly(['vanished']) && isMember(m, s) && (onlyAdded('vanished', m.name) || onlyTakenOut('vanished', m.name));
    }
    function ownNickname(m, k, s) {
      return k.hasOnly(['nicknames']) && isMember(m, s)
        && request.resource.data.get('nicknames', {}).diff(s.get('nicknames', {})).affectedKeys().hasOnly([m.name]);
    }
    // A kick needs Kick Members, a ban (it takes them out too) Ban Members, and so on. The audit log is kept by whoever
    // does something worth logging, so only someone who can moderate something writes it.
    function managing(m, k, s) {
      let p = permsIn(m, s);
      let needed = (k.hasAny(['name', 'description', 'iconUrl']) ? ['manageServer'] : [])
        .concat(k.hasAny(['roles', 'memberRoles', 'roleEdit']) ? ['manageRoles'] : [])
        .concat(k.hasAny(['bannedUsers', 'banInfo']) ? ['banMembers'] : [])
        .concat(k.hasAny(['timeouts']) ? ['timeoutMembers'] : [])
        .concat(k.hasAny(['nicknames']) ? ['manageNicknames'] : [])
        .concat(k.hasAny(['members']) && !k.hasAny(['bannedUsers', 'banInfo']) ? ['kickMembers'] : [])
        .concat(k.difference(['name', 'description', 'iconUrl', 'roles', 'memberRoles', 'roleEdit', 'bannedUsers', 'banInfo', 'timeouts',
              'nicknames', 'members', 'apps', 'auditLog'].toSet()).size() > 0 ? ['manageServer'] : []);
      return (isMember(m, s) || m.rank >= 1) && active(m)
        && (!k.hasAny(['members']) || onlyRemoved('members'))
        && (!k.hasAny(['apps']) || s.get('ownerId', '') == m.name || m.rank >= 2)
        && (needed.size() == 0 || hasAll(p, needed))
        && (!k.hasAny(['auditLog']) || hasOne(p, ['kickMembers', 'banMembers', 'timeoutMembers', 'manageMessages', 'manageServer',
              'manageRoles', 'manageChannels', 'manageNicknames', 'viewAuditLog']))
        // making, editing and deleting roles: the owner, Frixion staff and Administrators (canEditRoles() in script.js)
        && (!k.hasAny(['roles']) || p.hasAny(['administrator']))
        // giving and taking roles: Manage Roles is enough for roles below your own highest (roleEditOk()), never yours
        && (!k.hasAny(['memberRoles']) || p.hasAny(['administrator']) || roleEditOk(m, s));
    }
    // Role order (v4.54), as the member menu shows it: with Manage Roles but not Administrator, you give or take one role
    // at a time, from someone else, and only a role ranked below one of yours. roleEdit says which (setMemberRole() in
    // script.js): m the member, i where the role is in the server's roles, j where your role that outranks it is (so
    // the rules look at just those two, instead of going through every role, which costs too many steps).
    function roleEditOk(m, s) {
      let e = request.resource.data.get('roleEdit', {});
      let roles = s.get('roles', []);
      let t = e.get('m', '');
      let i = e.get('i', -1);
      let j = e.get('j', -1);
      return t is string && t != m.name && i is int && j is int && i >= 0 && j >= 0 && i < roles.size() && j < roles.size()
        && request.resource.data.get('memberRoles', {}).diff(s.get('memberRoles', {})).affectedKeys().hasOnly([t])
        && oneRoleChanged(s.get('memberRoles', {}).get(t, []).toSet(), request.resource.data.get('memberRoles', {}).get(t, []).toSet(), roles[i].get('id', ''))
        && roles[j].get('id', '') in s.get('memberRoles', {}).get(m.name, [])
        && roles[j].get('position', 0) > roles[i].get('position', 0);
    }
    function oneRoleChanged(was, now, r) { return now == was.union([r].toSet()) || now == was.difference([r].toSet()); }
    function serverDelete(m) { return m.ok && (resource.data.get('ownerId', '') == m.name || m.rank >= 2); }
    function seesServer(m) { return active(m) && (m.name in resource.data.members || m.rank >= 1); }
    // What anyone in a server may change on a channel: the stamp of their own newest message there (unread dots). The
    // Discord bridge stamps Discord's.
    function channelUpdate(m, s, sid, cid) {
      let k = changed();
      let lm = request.resource.data.get('lastMessage', {});
      return inServer(m, s) && ((k.hasOnly(['lastMessageAt', 'lastMessage']) && lm.get('uid', '') == m.name
          && get(/databases/$(database)/documents/servers/$(sid)/channels/$(cid)/messages/$(lm.get('mid', '-'))).data.get('uid', '') == m.name)
        || hasOne(permsIn(m, s), ['manageChannels']));
    }
    // Posting needs View Channels and Send Messages in that channel, and keeping to its slowmode. Messages from Discord
    // only ever come from the bridge (functions/api/discord), never from a page.
    function chMsgCreate(m, s, ch, sid, cid) {
      let p = permsIn(m, s);
      let admin = p.hasAny(['administrator']);
      let cp = admin ? [].toSet() : chanPerms(m, s, ch, p);
      return inServer(m, s) && canPost(m) && notTimedOut(m, s) && (admin || cp.hasAll(['viewChannels', 'sendMessages']))
        && ((newAuthorIsMe(m) && (admin || (slowOk(m, ch, cp, sid, cid) && everyoneOk(cp)))) || newBotMessage(m, hasOne(p, ['manageMessages'])));
    }
    // @everyone and @here notify the whole server only from someone with Mention @everyone there; anyone else's message
    // has to carry everyoneBlocked (the app adds it), which the push function and the ping sound respect (v4.54).
    function everyoneOk(cp) {
      let d = request.resource.data;
      return cp.hasAny(['mentionEveryone']) || d.get('everyoneBlocked', false) == true
        || !(d.get('text', '') is string && d.get('text', '').matches('(?si)(.*[\\s\\(>])?@(everyone|here)(\\b.*)?'));
    }
    // Slowmode (v4.54): a message in a slowmode channel comes with a stamp of when its sender last posted there
    // (slow/{name}, written with it: addChannelMessage() in script.js), and the stamp before it has to be at least that
    // many seconds old. Bypass Slowmode, Manage Channels and Manage Messages there skip it, as in the app.
    function slowPath(sid, cid, name) { return /databases/$(database)/documents/servers/$(sid)/channels/$(cid)/slow/$(name); }
    function slowOk(m, ch, cp, sid, cid) {
      let secs = ch.get('slowmode', 0);
      return !(secs is number) || secs <= 0 || cp.hasAny(['bypassSlowmode', 'manageChannels', 'manageMessages'])
        || (getAfter(slowPath(sid, cid, m.name)).data.get('at', null) == request.time
            && (!exists(slowPath(sid, cid, m.name)) || get(slowPath(sid, cid, m.name)).data.at <= request.time - duration.value(int(secs), 's')));
    }
    function chMsgUpdate(m, s, ch) {
      let k = changed();
      let p = permsIn(m, s);
      return inServer(m, s) && canInChannel(m, s, ch, p, ['viewChannels']) && (ownEdit(m, k) || serverOthersEdit(m, k, p));
    }
    // Your own; anyone's with Manage Messages (and while deleting a whole channel); and old ones when the channel
    // auto-deletes. (A Discord user's message that is gone from Discord is deleted by the bridge, which checks Discord
    // first: removeGone() in functions/api/discord.)
    function chMsgDelete(m, s, ch) {
      return m.ok && (isMine(m) || m.rank >= 1 || (isMember(m, s) && active(m) && ((isOld() && ch.get('autoDelete', true) != false)
        || hasOne(permsIn(m, s), ['manageMessages', 'manageChannels']))));
    }
    function threadCreate(m, s, ch) {
      return inServer(m, s) && canPost(m) && request.resource.data.get('createdBy', '') == m.name
        && canInChannel(m, s, ch, permsIn(m, s), ['viewChannels']);
    }
    function threadUpdate(m, s) {
      // anyone in it counts a reply (one at a time); its starter and Manage Threads change the rest
      return inServer(m, s) && ((changed().hasOnly(['lastMessageAt', 'messageCount'])
          && request.resource.data.get('messageCount', 0) == resource.data.get('messageCount', 0) + 1)
        || resource.data.get('createdBy', '') == m.name || hasOne(permsIn(m, s), ['manageThreads']));
    }
    function threadDelete(m, s) {
      return m.ok && (resource.data.get('createdBy', '') == m.name || hasOne(permsIn(m, s), ['manageThreads', 'manageChannels']));
    }
    // A thread's messages go with its channel: seeing them needs View Channels there, posting Send Messages in Threads.
    function threadMsgCreate(m, s, ch) {
      let p = permsIn(m, s);
      let admin = p.hasAny(['administrator']);
      let cp = admin ? [].toSet() : chanPerms(m, s, ch, p);
      return inServer(m, s) && canPost(m) && notTimedOut(m, s) && (admin || cp.hasAll(['viewChannels', 'sendMessagesInThreads']))
        && ((newAuthorIsMe(m) && (admin || everyoneOk(cp))) || newBotMessage(m, hasOne(p, ['manageMessages'])));
    }
    function threadMsgUpdate(m, s, ch) {
      let k = changed();
      let p = permsIn(m, s);
      return inServer(m, s) && canInChannel(m, s, ch, p, ['viewChannels']) && (ownEdit(m, k) || serverOthersEdit(m, k, p));
    }
    function threadMsgDelete(m, s) {
      return m.ok && (isMine(m) || m.rank >= 1 || (isMember(m, s) && active(m) && hasOne(permsIn(m, s), ['manageMessages', 'manageChannels'])));
    }
    // (a typing note shows the name of whoever it belongs to, nobody else's)
    function typingWrite(m, s, ch, name) { return m.name == name && typingName(name) && seesChannel(m, s, ch); }
    function typingName(name) { return request.resource == null || request.resource.data.get('username', name) == name; }
    // What anyone may see of a server before joining it: its card (Explore Servers and invites), a copy of its name,
    // picture, description, invite code, size and age that its members keep up to date (syncServerCard() in script.js).
    // It has to match the server exactly, so nobody can make a card say something else.
    function cardMatches(m, s) {
      let d = request.resource.data;
      return active(m) && isMember(m, s)
        && d.keys().hasOnly(['name', 'iconUrl', 'description', 'inviteCode', 'memberCount', 'createdAt'])
        && d.get('name', null) == s.get('name', null) && d.get('iconUrl', null) == s.get('iconUrl', null)
        && d.get('description', null) == s.get('description', null) && d.get('inviteCode', null) == s.get('inviteCode', null)
        && d.get('createdAt', null) == s.get('createdAt', null)
        && d.get('memberCount', -1) == s.get('members', []).toSet().difference(s.get('vanished', []).toSet()).size();
    }

    match /servers/{sid} {
      allow get, list: if seesServer(who());                         // others see its card (serverCards)
      allow create: if serverCreate(who());
      allow update: if serverUpdate(who(), resource.data);
      allow delete: if serverDelete(who());

      match /categories/{cat} {
        allow read: if inServer(who(), srv(sid));
        allow write: if canManageChannels(who(), srv(sid));
      }
      match /channels/{cid} {
        allow read: if inServer(who(), srv(sid));                   // a channel's name and settings; its messages need View Channels
        allow create, delete: if canManageChannels(who(), srv(sid));
        allow update: if channelUpdate(who(), srv(sid), sid, cid);

        match /messages/{mid} {
          allow read: if seesChannel(who(), srv(sid), chan(sid, cid));
          allow create: if chMsgCreate(who(), srv(sid), chan(sid, cid), sid, cid);
          allow update: if chMsgUpdate(who(), srv(sid), chan(sid, cid));
          allow delete: if chMsgDelete(who(), srv(sid), chan(sid, cid));
        }
        match /typing/{name} {
          allow read: if seesChannel(who(), srv(sid), chan(sid, cid));
          allow write: if typingWrite(who(), srv(sid), chan(sid, cid), name);
        }
        // when each person last posted here, for slowmode (slowOk()): only ever set to now, by its owner, never removed
        match /slow/{name} {
          allow read: if isWho(who(), name);
          allow create, update: if isWho(who(), name) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
            && inServer(who(), srv(sid));
        }
      }
      match /threads/{tid} {
        allow read: if inServer(who(), srv(sid));
        allow create: if threadCreate(who(), srv(sid), chan(sid, request.resource.data.get('channelId', '-')));
        allow update: if threadUpdate(who(), srv(sid));
        allow delete: if threadDelete(who(), srv(sid));

        match /messages/{mid} {
          allow read: if seesChannel(who(), srv(sid), chan(sid, threadOf(sid, tid).get('channelId', '-')));
          allow create: if threadMsgCreate(who(), srv(sid), chan(sid, threadOf(sid, tid).get('channelId', '-')));
          allow update: if threadMsgUpdate(who(), srv(sid), chan(sid, threadOf(sid, tid).get('channelId', '-')));
          allow delete: if threadMsgDelete(who(), srv(sid));
        }
        match /typing/{name} {
          allow read: if seesChannel(who(), srv(sid), chan(sid, threadOf(sid, tid).get('channelId', '-')));
          allow write: if typingWrite(who(), srv(sid), chan(sid, threadOf(sid, tid).get('channelId', '-')), name);
        }
      }
    }
    match /serverCards/{sid} {
      allow get, list: if signedIn();
      allow create, update: if cardMatches(who(), srv(sid));
      allow delete: if !exists(/databases/$(database)/documents/servers/$(sid)) || isOwnerLevel(who());
    }

    // ---------- DMs and group DMs ----------
    function dmData(did) { return get(/databases/$(database)/documents/dms/$(did)).data; }
    function gdmData(gid) { return get(/databases/$(database)/documents/groupDMs/$(gid)).data; }
    function inConv(m, c) { return active(m) && m.name in c.get('participants', []); }
    function convGet(m) { return active(m) && (resource == null || m.name in resource.data.get('participants', []) || m.rank >= 1); }
    function convList(m) { return active(m) && (m.name in resource.data.get('participants', []) || m.rank >= 1); }
    // (Sapphire's purge cards here only for Frixion staff, the only ones who can purge a DM or group.)
    function convMsgCreate(m, c) { return inConv(m, c) && canPost(m) && (newAuthorIsMe(m) || newBotMessage(m, m.rank >= 1)); }
    function convMsgUpdate(m, c) { let k = changed(); return inConv(m, c) && (ownEdit(m, k) || dmOthersEdit(m, k)); }
    function convMsgDelete(m, c) { return inConv(m, c) && (isMine(m) || m.rank >= 1 || (isOld() && c.get('autoDelete', true) != false)); }
    function convTyping(m, c, name) { return inConv(m, c) && m.name == name && typingName(name); }

    // A DM's id is its two usernames, sorted and joined with "_" (dmIdFor() in script.js).
    function dmCreate(m, did) {
      let p = request.resource.data.get('participants', null);
      return m.ok && p is list && p.size() == 2 && m.name in p && (did == p[0] + '_' + p[1] || did == p[1] + '_' + p[0]);
    }
    // The preview of a conversation's last message carries the sender's own name, or a bot's (postBotMessage()).
    function previewOk(m) {
      return !changed().hasAny(['lastMessage']) || request.resource.data.get('lastMessage', {}).get('username', '') in [m.name, 'Sapphire', 'Wordle'];
    }
    function dmUpdate(m) { return active(m) && previewOk(m) && same('participants') && (m.name in resource.data.get('participants', []) || m.rank >= 1); }
    // Only your friends can be put in a group by you.
    function onlyFriendsAdded(m, before) {
      return request.resource.data.get('participants', []).toSet().difference(before.toSet())
        .difference(m.u.get('friends', []).toSet().union([m.name].toSet())).size() == 0;
    }
    function groupCreate(m) {
      let p = request.resource.data.get('participants', null);
      return m.ok && p is list && m.name in p && request.resource.data.get('ownerId', '') == m.name && onlyFriendsAdded(m, []);
    }
    // People in the group change it (adding their friends, or leaving); only the group's owner takes someone else out,
    // and hands the group on when they leave.
    function groupUpdate(m) {
      let before = resource.data.get('participants', []);
      let owner = resource.data.get('ownerId', '') == m.name;
      return active(m) && (m.name in before || m.rank >= 1) && previewOk(m)
        && (same('ownerId') || owner || m.rank >= 1)
        && (same('participants') || m.rank >= 1 || (onlyFriendsAdded(m, before)
            && (owner || before.toSet().difference(listAfter('participants').toSet()).difference([m.name].toSet()).size() == 0)));
    }

    match /dms/{did} {
      allow get: if convGet(who());
      allow list: if convList(who());
      allow create: if dmCreate(who(), did);
      allow update: if dmUpdate(who());
      allow delete: if isOwnerLevel(who());

      match /messages/{mid} {
        allow read: if inConv(who(), dmData(did));
        allow create: if convMsgCreate(who(), dmData(did));
        allow update: if convMsgUpdate(who(), dmData(did));
        allow delete: if convMsgDelete(who(), dmData(did));
      }
      match /typing/{name} {
        allow read: if inConv(who(), dmData(did));
        allow write: if convTyping(who(), dmData(did), name);
      }
    }
    match /groupDMs/{gid} {
      allow get: if convGet(who());
      allow list: if convList(who());
      allow create: if groupCreate(who());
      allow update: if groupUpdate(who());
      allow delete: if isOwnerLevel(who());

      match /messages/{mid} {
        allow read: if inConv(who(), gdmData(gid));
        allow create: if convMsgCreate(who(), gdmData(gid));
        allow update: if convMsgUpdate(who(), gdmData(gid));
        allow delete: if convMsgDelete(who(), gdmData(gid));
      }
      match /typing/{name} {
        allow read: if inConv(who(), gdmData(gid));
        allow write: if convTyping(who(), gdmData(gid), name);
      }
    }

    // ---------- push notifications ----------
    // Each device's subscription (savePushSub()). Only its owner sees or changes it; the same device signing in as
    // someone else takes it over (it has to know the subscription's address to do that).
    match /pushSubs/{id} {
      allow get, delete: if pushMine(who());
      allow create: if pushNew(who());
      allow update: if pushNew(who()) && (pushMine(who()) || resource.data.get('endpoint', '') == request.resource.data.get('endpoint', null));
    }
    function pushMine(m) { return m.ok && resource.data.get('uid', '') == m.name; }
    function pushNew(m) { return m.ok && request.resource.data.get('uid', '') == m.name; }

    // ---------- Discord bridge ----------
    // The list of linked channels the bridge's timer goes through (bridgeList()). Anyone in the server keeps it up to
    // date; the bridge checks each link's signature itself, so a made-up entry does nothing.
    match /discordLinks/{key} {
      allow read: if isStaff(who());
      allow create: if request.resource.data.keys().hasOnly(['sid', 'cid', 'channel', 'at'])
        && request.resource.data.get('sid', null) is string && request.resource.data.get('cid', null) is string
        && key == request.resource.data.sid + '__' + request.resource.data.cid
        && inServer(who(), srv(request.resource.data.sid));
      allow update: if changed().hasOnly(['channel', 'at']) && inServer(who(), srv(resource.data.sid));
      allow delete: if canManageChannels(who(), srv(resource.data.sid));
    }

    // ---------- games ----------
    // Overcontrol RNG saves: yours (and your Steal a Character fallback) are yours; its admin tools are for the Owner and
    // Co-Owners (staff in games/ocrng/ocrng.js).
    match /rngSaves/{id} {
      allow read: if signedIn();
      allow write: if rngWrite(who(), id);
    }
    function rngWrite(m, id) { return m.ok && (m.name == id || id == 'sac_' + m.name || m.rank >= 2); }
    match /rngCodes/{code} {
      allow get: if signedIn();
      allow list, create, delete: if isOwnerLevel(who());
      allow update: if (signedIn() && changed().hasOnly(['uses']) && request.resource.data.get('uses', 0) == resource.data.get('uses', 0) + 1)
        || isOwnerLevel(who());
    }
    match /sacSaves/{id} {
      allow read: if signedIn();
      allow write: if isWho(who(), id) || isOwnerLevel(who());
    }
  }
}
